---
// The three install steps, drawn on a small Mac desktop with Annotator's own marks: numbered
// counters, a curved arrow and a rough ellipse. The icons are the real app and menu bar icons.
// It is a picture of the list beside it, so assistive technology skips it. The resting state is the
// finished drawing; motion.css plays the drag and the menu bar click once when it arrives.
import { sitePath } from "../lib/paths";
const icon = sitePath("/app/app-icon.png");
// Annotator's menu bar glyph (website/public/mark.svg without its tile or dot, as in MenuBarIcon.swift).
const glyph = "M39 19c-17-10-32 17-19 26 6 4 13-1 17-9l-1 9h7l5-28h-8zm-4 7c-2 10-8 16-11 13-4-4 4-18 11-13z";
const counters = [
  { n: 1, x: 130, y: 138 },
  { n: 2, x: 278, y: 124 },
  { n: 3, x: 412, y: 47 },
];
---
<figure class="install-scene" data-reveal="scene" aria-hidden="true">
  <svg viewBox="0 0 560 350" focusable="false">
    <defs>
      <radialGradient id="scene-wall" cx="18%" cy="-8%" r="118%">
        <stop offset="0" stop-color="#2d4166"/>
        <stop offset=".52" stop-color="#172339"/>
        <stop offset="1" stop-color="#0d1321"/>
      </radialGradient>
      <linearGradient id="scene-folder-back" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#5a82c0"/><stop offset="1" stop-color="#3f6096"/>
      </linearGradient>
      <linearGradient id="scene-folder-front" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#80a8e2"/><stop offset="1" stop-color="#5b83bf"/>
      </linearGradient>
      <filter id="scene-shadow" x="-20%" y="-20%" width="140%" height="170%">
        <feDropShadow dx="0" dy="16" stdDeviation="18" flood-color="#000" flood-opacity=".5"/>
      </filter>
      <symbol id="scene-app" viewBox="0 0 256 256"><image href={icon} width="256" height="256"/></symbol>
    </defs>

    <rect width="560" height="350" fill="url(#scene-wall)"/>

    <g class="scene-menubar">
      <rect width="560" height="24" fill="#0a0f18" fill-opacity=".78"/>
      <path d="M0 24.5H560" stroke="#ffffff17"/>
      <g fill="#ffffff" fill-opacity=".3">
        <rect x="18" y="9" width="30" height="6" rx="3" fill-opacity=".55"/>
        <rect x="58" y="9" width="20" height="6" rx="3"/>
        <rect x="88" y="9" width="24" height="6" rx="3"/>
        <rect x="122" y="9" width="28" height="6" rx="3"/>
      </g>
      <path class="scene-glyph" d={glyph} transform="translate(432.3 0) scale(.387)" fill="#f1f4fc"/>
      <g fill="none" stroke="#f1f4fc" stroke-opacity=".8" stroke-width="1.2">
        <rect x="470.5" y="6.5" width="13" height="5" rx="2.5"/>
        <rect x="470.5" y="13" width="13" height="5" rx="2.5"/>
        <rect x="492.5" y="7.5" width="19" height="9" rx="2.6"/>
      </g>
      <rect x="494.3" y="9.3" width="12" height="5.4" rx="1.4" fill="#f1f4fc" fill-opacity=".85"/>
      <rect x="512.6" y="10.2" width="1.8" height="3.6" rx=".9" fill="#f1f4fc" fill-opacity=".6"/>
      <text x="548" y="16" text-anchor="end" class="scene-time">10:24</text>
    </g>

    <g class="scene-window">
      <rect x="64" y="70" width="432" height="214" rx="14" fill="#131a29" filter="url(#scene-shadow)"/>
      <path d="M78 70H482A14 14 0 0 1 496 84V104H64V84A14 14 0 0 1 78 70Z" fill="#1a2336"/>
      <path d="M64 104.5H496" stroke="#ffffff12"/>
      <rect x="64.5" y="70.5" width="431" height="213" rx="13.5" fill="none" stroke="#ffffff1f"/>
      <g fill="#36435c"><circle cx="84" cy="87" r="5.5"/><circle cx="100" cy="87" r="5.5"/><circle cx="116" cy="87" r="5.5"/></g>

      <rect class="scene-select" x="120" y="128" width="104" height="128" rx="12" fill="#ffffff12" stroke="#ffffff1c"/>
      <use href="#scene-app" x="132" y="140" width="80" height="80"/>
      <text x="172" y="243" text-anchor="middle" class="scene-label">Annotator</text>

      <rect class="scene-drop" x="332" y="128" width="120" height="128" rx="12" fill="#ffb58c1f" stroke="#ffb58c80" stroke-width="1.5"/>
      <path d="M344 154a8 8 0 0 1 8-8h26a6 6 0 0 1 4.6 2.2l5 6h44.4a8 8 0 0 1 8 8v50a8 8 0 0 1-8 8h-80a8 8 0 0 1-8-8z" fill="url(#scene-folder-back)"/>
      <path d="M344 170a8 8 0 0 1 8-8h80a8 8 0 0 1 8 8v42.2a8 8 0 0 1-8 8h-80a8 8 0 0 1-8-8z" fill="url(#scene-folder-front)"/>
      <path d="M352 162.9h80" stroke="#ffffff47"/>
      <g fill="#ffffff" fill-opacity=".34">
        <rect x="383" y="182" width="10" height="10" rx="3"/><rect x="397" y="182" width="10" height="10" rx="3"/>
        <rect x="383" y="196" width="10" height="10" rx="3"/><rect x="397" y="196" width="10" height="10" rx="3"/>
      </g>
      <text x="392" y="243" text-anchor="middle" class="scene-label">Applications</text>
    </g>

    {/* Annotator is not in the Dock: it runs from the menu bar. The other apps are made-up samples. */}
    <g class="scene-dock">
      <rect x="203" y="314" width="154" height="28" rx="9" fill="#0a0f18" fill-opacity=".55" stroke="#ffffff17"/>
      <rect x="211" y="319" width="18" height="18" rx="5" fill="#4d6592"/>
      <rect x="237" y="319" width="18" height="18" rx="5" fill="#6a5a92"/>
      <rect x="263" y="319" width="18" height="18" rx="5" fill="#3f7c76"/>
      <rect x="289" y="319" width="18" height="18" rx="5" fill="#8a6a4b"/>
      <rect x="315" y="319" width="18" height="18" rx="5" fill="#5b667d"/>
      <rect x="339" y="319" width="10" height="18" rx="3" fill="#ffffff" fill-opacity=".12"/>
    </g>

    <g class="scene-marks">
      <path class="scene-ink scene-arrow" d="M216 176C244 138 312 136 340 170" pathLength="1"/>
      <path class="scene-ink scene-arrowhead" d="M326.9 165.1 340 170 337.7 156.2" pathLength="1"/>
      <path class="scene-ink scene-circle" pathLength="1"
        d="M431.1 4.8C440.2 1.4 456 1.8 461.9 6.5C465.9 10.1 464.5 18 456.6 20.8C446.9 24 432.6 23.2 426.4 18.9C422.4 15.9 423.3 8.6 429.6 5.6C435.5 3.1 444.3 2.2 452.2 3.5"/>
      {counters.map(({ n, x, y }) => (
        <g class="scene-counter">
          <circle cx={x} cy={y} r="11.5"/>
          <text x={x} y={y + 4.4} text-anchor="middle">{n}</text>
        </g>
      ))}
      <circle class="scene-ripple" cx="444" cy="12" r="9"/>
    </g>

    <g class="scene-pointer">
      <g class="scene-px"><g class="scene-py">
        <g class="scene-ghost"><use href="#scene-app" x="-34" y="-30" width="68" height="68" opacity=".62"/></g>
        <g class="scene-press"><path d="M0 0V17.6L4.3 13.5 7.4 20.6 10.5 19.2 7.5 12.3H13.3Z" fill="#fff" stroke="#0b101a" stroke-width="1.3" stroke-linejoin="round"/></g>
      </g></g>
    </g>
  </svg>
</figure>
