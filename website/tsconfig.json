{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/scripts/**/*.ts", "src/lib/**/*.ts", "src/data/**/*.ts", "src/env.d.ts"]
}
