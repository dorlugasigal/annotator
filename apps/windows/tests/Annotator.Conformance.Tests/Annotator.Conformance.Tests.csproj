<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compares the Windows port with the macOS conformance corpus in reference/conformance (spec 013, WIN-PAR-02).
       The corpus is read from the repository unchanged. Platform-neutral, so the tests run on Windows, macOS and Linux. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Annotator.Conformance.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Annotator.Workspace\Annotator.Workspace.csproj" />
  </ItemGroup>
</Project>
