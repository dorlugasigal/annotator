<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development tool, outside the solution: writes the Windows app's MSIX logos and executable icon from the app icon
       artwork (apps/macos/Artwork/main.swift's geometry and output colors). Never shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Annotator.IconExport</RootNamespace>
    <AssemblyName>Annotator.IconExport</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Annotator.Workspace\Annotator.Workspace.csproj" />
  </ItemGroup>
</Project>
