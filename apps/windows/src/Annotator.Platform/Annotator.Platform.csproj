<Project Sdk="Microsoft.NET.Sdk">
  <!-- Annotator.Platform: Win32, Windows.UI.Composition and DirectX services for the desktop overlay. Windows only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <RootNamespace>Annotator.Platform</RootNamespace>
    <AssemblyName>Annotator.Platform</AssemblyName>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Annotator.Platform.Tests" />
  </ItemGroup>
</Project>
