<Project>
  <!-- The version that the Mac and Windows apps share (WIN-DST-04): MARKETING_VERSION in the base settings of
       apps/macos/project.yml, a plain X.Y.Z read as tools/release/release.py reads it and checked like Annotator.Workspace's
       SharedVersion. The build is derived from it, never counted: Major * 10000 + Minor * 100 + Patch (0.2.0 is 200), so
       minor and patch stay at 99 or lower. CURRENT_PROJECT_VERSION, the Mac's build, must hold the same number. The
       assembly and file versions are X.Y.Z.0 (0.2.0.0), the app shows X.Y.Z, and the MSIX package version is
       (Major + 1).Minor.Patch.0 (1.2.0.0). -->
  <PropertyGroup>
    <AnnotatorProjectYml Condition="'$(AnnotatorProjectYml)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)..\..\..\macos\project.yml'))</AnnotatorProjectYml>
    <_AnnotatorProjectYmlText Condition="Exists('$(AnnotatorProjectYml)')">$([System.IO.File]::ReadAllText('$(AnnotatorProjectYml)'))</_AnnotatorProjectYmlText>
    <_AnnotatorVersionCount>$([System.Text.RegularExpressions.Regex]::Matches('$(_AnnotatorProjectYmlText)', '(?m)^    MARKETING_VERSION:').Count)</_AnnotatorVersionCount>
    <_AnnotatorProjectBuildCount>$([System.Text.RegularExpressions.Regex]::Matches('$(_AnnotatorProjectYmlText)', '(?m)^    CURRENT_PROJECT_VERSION:').Count)</_AnnotatorProjectBuildCount>
    <_AnnotatorVersionRaw>$([System.Text.RegularExpressions.Regex]::Match('$(_AnnotatorProjectYmlText)', '(?m)(?&lt;=^    MARKETING_VERSION: *)[^\r\n]*?(?= *\r?$)'))</_AnnotatorVersionRaw>
    <_AnnotatorProjectBuildRaw>$([System.Text.RegularExpressions.Regex]::Match('$(_AnnotatorProjectYmlText)', '(?m)(?&lt;=^    CURRENT_PROJECT_VERSION: *)[^\r\n]*?(?= *\r?$)'))</_AnnotatorProjectBuildRaw>
    <AnnotatorSharedVersion>$(_AnnotatorVersionRaw.Trim().Replace('"', '').Replace("'", ''))</AnnotatorSharedVersion>
    <_AnnotatorProjectBuild>$(_AnnotatorProjectBuildRaw.Trim().Replace('"', '').Replace("'", ''))</_AnnotatorProjectBuild>
    <_AnnotatorVersionFormatValid>false</_AnnotatorVersionFormatValid>
    <_AnnotatorVersionFormatValid Condition="'$(_AnnotatorVersionCount)' == '1' and '$(_AnnotatorProjectBuildCount)' == '1' and
                                             $([System.Text.RegularExpressions.Regex]::IsMatch('$(AnnotatorSharedVersion)', '^(0|[1-9][0-9]{0,4})\.(0|[1-9][0-9]?)\.(0|[1-9][0-9]?)$'))">true</_AnnotatorVersionFormatValid>
    <_AnnotatorVersionValid>false</_AnnotatorVersionValid>
    <_AnnotatorBuildMatches>false</_AnnotatorBuildMatches>
  </PropertyGroup>
  <!-- MSIX and assembly version parts are 16-bit, and an assembly version part may be at most 65534. -->
  <PropertyGroup Condition="'$(_AnnotatorVersionFormatValid)' == 'true'">
    <_AnnotatorMajor>$(AnnotatorSharedVersion.Split('.')[0])</_AnnotatorMajor>
    <_AnnotatorMinor>$(AnnotatorSharedVersion.Split('.')[1])</_AnnotatorMinor>
    <_AnnotatorPatch>$(AnnotatorSharedVersion.Split('.')[2])</_AnnotatorPatch>
    <AnnotatorBuildNumber>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($(_AnnotatorMajor), 10000)), $([MSBuild]::Multiply($(_AnnotatorMinor), 100)))), $(_AnnotatorPatch)))</AnnotatorBuildNumber>
    <_AnnotatorVersionValid Condition="$(_AnnotatorMajor) &lt;= 65533 and $(AnnotatorBuildNumber) &gt; 0">true</_AnnotatorVersionValid>
    <_AnnotatorBuildMatches Condition="$([System.String]::Equals('$(_AnnotatorProjectBuild)', '$(AnnotatorBuildNumber)'))">true</_AnnotatorBuildMatches>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_AnnotatorVersionValid)' == 'true' and '$(_AnnotatorBuildMatches)' == 'true'">
    <Version>$(AnnotatorSharedVersion)</Version>
    <AssemblyVersion>$(AnnotatorSharedVersion).0</AssemblyVersion>
    <FileVersion>$(AnnotatorSharedVersion).0</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AnnotatorMsixVersion>$([MSBuild]::Add($(_AnnotatorMajor), 1)).$(_AnnotatorMinor).$(_AnnotatorPatch).0</AnnotatorMsixVersion>
  </PropertyGroup>
  <Target Name="AnnotatorCheckSharedVersion" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(_AnnotatorVersionValid)' != 'true'"
           Text="Could not read the shared version from $(AnnotatorProjectYml). It needs one base MARKETING_VERSION, three numbers such as 0.2.0 with nothing after them (above 0.0.0, major at most 65533, minor and patch at most 99), and one base CURRENT_PROJECT_VERSION, as tools/release/release.py reads them." />
    <Error Condition="'$(_AnnotatorVersionValid)' == 'true' and '$(_AnnotatorBuildMatches)' != 'true'"
           Text="CURRENT_PROJECT_VERSION in $(AnnotatorProjectYml) is '$(_AnnotatorProjectBuild)', but version $(AnnotatorSharedVersion) has build $(AnnotatorBuildNumber) (Major * 10000 + Minor * 100 + Patch). Change the version with python3 tools/release/release.py prepare --version X.Y.Z, which writes both." />
  </Target>
</Project>
