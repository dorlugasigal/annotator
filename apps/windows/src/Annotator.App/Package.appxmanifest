<?xml version="1.0" encoding="utf-8"?>
<!--
  Annotator's MSIX package manifest (WIN-DST-01, WIN-SYS-01, WIN-SYS-04). The build copies it into obj and sets the
  Identity Version from the shared version: (Major + 1).Minor.Build.0 (SharedVersion.props, WIN-DST-04).

  The Store identity comes from Partner Center > Annotator – Screen Annotation > Product management > Product identity
  (Store ID 9NMZ345ZJ6JK, package family DorLugasi-Gal.AnnotatorScreenAnnotation_es65rrkpa6e10), copied exactly on
  2026-10-20. Both DisplayName values are the reserved name, which the Store requires and Windows shows in Start and in
  Settings > Apps; the app's own windows, About, tray icon, tile label and startup task keep the name Annotator
  (specification 013, recorded decisions). The publisher's Store check reads them (docs/maintainers/windows-store.md).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:uap11="http://schemas.microsoft.com/appx/manifest/uap/windows10/11"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 uap10 uap11 rescap">

  <Identity
    Name="DorLugasi-Gal.AnnotatorScreenAnnotation"
    Publisher="CN=9BC8A074-AAD1-4E16-8AC2-B68940F537CD"
    Version="0.0.0.0" />

  <Properties>
    <DisplayName>Annotator – Screen Annotation</DisplayName>
    <PublisherDisplayName>Dor Lugasi-Gal</PublisherDisplayName>
    <Logo>Assets\Package\StoreLogo.png</Logo>
  </Properties>

  <!-- Windows 11 22H2 or later (D-1). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Annotator – Screen Annotation"
        Description="Draw on your desktop. Keep your app open."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Package\Square150x150Logo.png"
        Square44x44Logo="Assets\Package\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="Annotator"
          Wide310x150Logo="Assets\Package\Wide310x150Logo.png"
          Square71x71Logo="Assets\Package\SmallTile.png"
          Square310x310Logo="Assets\Package\LargeTile.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Launch at sign-in (WIN-SYS-01): off until the person turns it on in Settings. The parameter marks the quiet launch. -->
        <uap5:Extension
          Category="windows.startupTask"
          Executable="Annotator.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--startup-task">
          <uap5:StartupTask TaskId="AnnotatorStartup" Enabled="false" DisplayName="Annotator" />
        </uap5:Extension>
        <!-- Boards open in Annotator (WIN-SYS-04): the path arrives as the first argument, as for Annotator.exe <board>. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="annotatorboard" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Annotator board</uap:DisplayName>
            <uap:Logo>Assets\Package\StoreLogo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.annotator</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (full trust) app. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Screen pixels for zoom, the pointer lens, Blur, Pixelate, Distort and region sharing, read only while one of them
         runs (WIN-CAP-01, WIN-CAP-04): capture items that Annotator creates itself, without the yellow capture border. -->
    <uap11:Capability Name="graphicsCaptureProgrammatic" />
    <uap11:Capability Name="graphicsCaptureWithoutBorder" />
  </Capabilities>
</Package>
