<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Annotator.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Light and Dark use the Mac's resolved system colors (reference/ux-reference/macos/design-values.json):
                     windowBackgroundColor, labelColor, secondaryLabelColor, disabledControlTextColor, separatorColor,
                     systemGreen and systemRed, and Color.primary at the opacities ToolbarView uses. The accent is the Mac's
                     controlAccentColor, #007AFF in both themes, not the Windows accent (owner decision of 2026-10-19,
                     specification 013). WinUI's accent keys get it too, so the slider, the value field and other WinUI
                     controls match: the light theme's default accent fill uses SystemAccentColorDark1 and the dark theme's
                     SystemAccentColorLight2, so those are #007AFF and the others step lighter and darker from it. -->
                <ResourceDictionary x:Key="Light">
                    <Color x:Key="AnnotatorAccentColor">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColor">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF3395FF</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF66AFFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF99CAFF</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF0062CC</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF004999</Color>
                    <SolidColorBrush x:Key="AnnotatorWindowBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorLabelBrush" Color="#D8000000" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelBrush" Color="#7F000000" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelBrush" Color="#3F000000" />
                    <SolidColorBrush x:Key="AnnotatorLabelSolidBrush" Color="#FF272727" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelSolidBrush" Color="#FF7C7B79" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelSolidBrush" Color="#FFC0C0C0" />
                    <SolidColorBrush x:Key="AnnotatorSeparatorBrush" Color="#19000000" />
                    <SolidColorBrush x:Key="AnnotatorSurfaceStrokeBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="AnnotatorSwatchStrokeBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="AnnotatorControlFillBrush" Color="#05000000" />
                    <SolidColorBrush x:Key="AnnotatorControlSelectedFillBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="AnnotatorControlStrokeBrush" Color="#29000000" />
                    <SolidColorBrush x:Key="AnnotatorAccentBrush" Color="{ThemeResource AnnotatorAccentColor}" />
                    <SolidColorBrush x:Key="AnnotatorSelectionFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.17" />
                    <SolidColorBrush x:Key="AnnotatorBoardFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.15" />
                    <SolidColorBrush x:Key="AnnotatorModeStripFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.13" />
                    <SolidColorBrush x:Key="AnnotatorPendingStripFillBrush" Color="#FFFF8D28" Opacity="0.13" />
                    <SolidColorBrush x:Key="AnnotatorSelectionStrokeBrush" Color="#26000000" />
                    <SolidColorBrush x:Key="AnnotatorDrawModeBrush" Color="#2634C759" />
                    <SolidColorBrush x:Key="AnnotatorAppsModeBrush" Color="#0D000000" />
                    <SolidColorBrush x:Key="AnnotatorDrawDotBrush" Color="#FF34C759" />
                    <SolidColorBrush x:Key="AnnotatorErrorBrush" Color="#FFFF383C" />
                    <SolidColorBrush x:Key="AnnotatorMenuBackgroundBrush" Color="#FFF8F6F2" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentBrush" Color="#FF2B4536" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorMenuPrimaryFocusBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorMenuHoverBrush" Color="#11000000" />
                    <SolidColorBrush x:Key="AnnotatorWarningBrush" Color="#FFB45309" />
                    <SolidColorBrush x:Key="AnnotatorQuickRegionFillBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="AnnotatorSupportFillBrush" Color="#24FF8D28" />
                    <SolidColorBrush x:Key="AnnotatorSupportStrokeBrush" Color="#4DFF8D28" />
                    <!-- The Mac's systemOrange (design-values.json) and its small pop-up button's fill (8% black). -->
                    <SolidColorBrush x:Key="AnnotatorOrangeBrush" Color="#FFFF8D28" />
                    <SolidColorBrush x:Key="AnnotatorPopUpFillBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="AnnotatorPopUpPressedBrush" Color="#29000000" />
                    <!-- Hover and press fills of the app's plain buttons, and the outlines a contrast theme draws instead. -->
                    <StaticResource x:Key="AnnotatorHoverFillBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="AnnotatorPressedFillBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="AnnotatorHoverStrokeBrush" Color="#00000000" />
                    <Thickness x:Key="AnnotatorHoverStrokeThickness">0</Thickness>
                    <SolidColorBrush x:Key="AnnotatorSelectedOutlineBrush" Color="#00000000" />
                    <Thickness x:Key="AnnotatorSelectedOutlineThickness">0</Thickness>
                    <!-- The tray menu primary button's keycap: white at 13% on the button. -->
                    <SolidColorBrush x:Key="AnnotatorKeycapFillBrush" Color="#21FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <Color x:Key="AnnotatorAccentColor">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColor">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColorLight1">#FF0062CC</Color>
                    <Color x:Key="SystemAccentColorLight2">#FF007AFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#FF3395FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#FF0062CC</Color>
                    <Color x:Key="SystemAccentColorDark2">#FF004999</Color>
                    <Color x:Key="SystemAccentColorDark3">#FF003166</Color>
                    <SolidColorBrush x:Key="AnnotatorWindowBackgroundBrush" Color="#FF1E1E1E" />
                    <SolidColorBrush x:Key="AnnotatorLabelBrush" Color="#D8FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelBrush" Color="#8CFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelBrush" Color="#3FFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorLabelSolidBrush" Color="#FFDDDDDD" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelSolidBrush" Color="#FF989A99" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelSolidBrush" Color="#FF565656" />
                    <SolidColorBrush x:Key="AnnotatorSeparatorBrush" Color="#19FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorSurfaceStrokeBrush" Color="#12FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorSwatchStrokeBrush" Color="#24FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorControlFillBrush" Color="#05FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorControlSelectedFillBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorControlStrokeBrush" Color="#29FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorAccentBrush" Color="{ThemeResource AnnotatorAccentColor}" />
                    <SolidColorBrush x:Key="AnnotatorSelectionFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.17" />
                    <SolidColorBrush x:Key="AnnotatorBoardFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.15" />
                    <SolidColorBrush x:Key="AnnotatorModeStripFillBrush" Color="{ThemeResource AnnotatorAccentColor}" Opacity="0.13" />
                    <SolidColorBrush x:Key="AnnotatorPendingStripFillBrush" Color="#FFFF9230" Opacity="0.13" />
                    <SolidColorBrush x:Key="AnnotatorSelectionStrokeBrush" Color="#2AFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorDrawModeBrush" Color="#2630D158" />
                    <SolidColorBrush x:Key="AnnotatorAppsModeBrush" Color="#0EFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorDrawDotBrush" Color="#FF30D158" />
                    <SolidColorBrush x:Key="AnnotatorErrorBrush" Color="#FFFF4245" />
                    <SolidColorBrush x:Key="AnnotatorMenuBackgroundBrush" Color="#FF1B1F1D" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentBrush" Color="#FF4D735C" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentForegroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorMenuPrimaryFocusBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorMenuHoverBrush" Color="#11FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorWarningBrush" Color="#FFFBBF24" />
                    <SolidColorBrush x:Key="AnnotatorQuickRegionFillBrush" Color="#0BFFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorSupportFillBrush" Color="#33FF9230" />
                    <SolidColorBrush x:Key="AnnotatorSupportStrokeBrush" Color="#4DFF9230" />
                    <SolidColorBrush x:Key="AnnotatorOrangeBrush" Color="#FFFF9230" />
                    <SolidColorBrush x:Key="AnnotatorPopUpFillBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="AnnotatorPopUpPressedBrush" Color="#29FFFFFF" />
                    <StaticResource x:Key="AnnotatorHoverFillBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
                    <StaticResource x:Key="AnnotatorPressedFillBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="AnnotatorHoverStrokeBrush" Color="#00000000" />
                    <Thickness x:Key="AnnotatorHoverStrokeThickness">0</Thickness>
                    <SolidColorBrush x:Key="AnnotatorSelectedOutlineBrush" Color="#00000000" />
                    <Thickness x:Key="AnnotatorSelectedOutlineThickness">0</Thickness>
                    <!-- The tray menu primary button's keycap: white at 13% on the button. -->
                    <SolidColorBrush x:Key="AnnotatorKeycapFillBrush" Color="#21FFFFFF" />
                </ResourceDictionary>
                <!-- A contrast theme shows selected and active controls with a Highlight outline over the window color, so their
                     glyphs and words keep the window text color; only the tray menu's primary button fills with Highlight,
                     with HighlightText on it. -->
                <ResourceDictionary x:Key="HighContrast">
                    <Color x:Key="AnnotatorAccentColor">#FF007AFF</Color>
                    <SolidColorBrush x:Key="AnnotatorWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorLabelSolidBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorSecondaryLabelSolidBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorDisabledLabelSolidBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorSurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorSwatchStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorControlFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorControlSelectedFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorControlStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AnnotatorSelectionFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorBoardFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorModeStripFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorPendingStripFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorSelectionStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorDrawModeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorAppsModeBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorDrawDotBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AnnotatorErrorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorMenuBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="AnnotatorMenuAccentForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorMenuPrimaryFocusBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorMenuHoverBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorWarningBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorQuickRegionFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorSupportFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorSupportStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorOrangeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AnnotatorPopUpFillBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AnnotatorPopUpPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
                    <SolidColorBrush x:Key="AnnotatorHoverFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorPressedFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AnnotatorHoverStrokeBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <Thickness x:Key="AnnotatorHoverStrokeThickness">1</Thickness>
                    <SolidColorBrush x:Key="AnnotatorSelectedOutlineBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <Thickness x:Key="AnnotatorSelectedOutlineThickness">2</Thickness>
                    <SolidColorBrush x:Key="AnnotatorKeycapFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- The Mac slider's knob is 20 by 16 points; the Windows thumb takes that size, with its ring drawn inside
                 (ParitySlider) and the inner dot in the Windows proportion. -->
            <x:Double x:Key="SliderHorizontalThumbWidth">20</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">10</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">10</x:Double>

            <!-- The window surfaces, like the Mac's fill with a 1-point strokeBorder: the background also fills under the
                 stroke, because the window around the surface is transparent. WinUI rounds the outer edge of a border by
                 CornerRadius plus BorderThickness, so the toolbar sets its radius one point smaller than the Mac's, and
                 the popover style uses 13 for the Mac's 14. -->
            <Style x:Key="AnnotatorToolbarSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorWindowBackgroundBrush}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="BorderBrush" Value="{ThemeResource AnnotatorSurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
            </Style>
            <Style x:Key="AnnotatorMenuSurface" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorMenuBackgroundBrush}" />
                <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
                <Setter Property="BorderBrush" Value="{ThemeResource AnnotatorSurfaceStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="13" />
            </Style>
            <Style x:Key="AnnotatorSelectionDraw" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorSelectionFillBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AnnotatorSelectedOutlineBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource AnnotatorSelectedOutlineThickness}" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="AnnotatorSelectionApps" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource AnnotatorSelectionStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="AnnotatorModeDraw" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorDrawModeBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AnnotatorSelectedOutlineBrush}" />
                <Setter Property="BorderThickness" Value="{ThemeResource AnnotatorSelectedOutlineThickness}" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="AnnotatorModeApps" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorAppsModeBrush}" />
                <Setter Property="CornerRadius" Value="7" />
            </Style>
            <Style x:Key="AnnotatorDotDraw" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource AnnotatorDrawDotBrush}" />
            </Style>
            <Style x:Key="AnnotatorDotApps" TargetType="Ellipse">
                <Setter Property="Fill" Value="{ThemeResource AnnotatorSecondaryLabelBrush}" />
            </Style>
            <Style x:Key="AnnotatorMenuPrimary" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorMenuAccentBrush}" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="AnnotatorKeycap" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AnnotatorKeycapFillBrush}" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="6,4,6,4" />
            </Style>
            <Style x:Key="AnnotatorPrimaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorLabelBrush}" />
            </Style>
            <Style x:Key="AnnotatorDisabledText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource AnnotatorDisabledLabelBrush}" />
        </Style>
        <Style x:Key="AnnotatorSecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorSecondaryLabelBrush}" />
            </Style>
            <Style x:Key="AnnotatorAccentText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorAccentBrush}" />
            </Style>
            <Style x:Key="AnnotatorOrangeText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorOrangeBrush}" />
            </Style>
            <Style x:Key="AnnotatorMenuAccentText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorMenuAccentForegroundBrush}" />
            </Style>
            <Style x:Key="AnnotatorWarningText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorWarningBrush}" />
            </Style>
            <Style x:Key="AnnotatorErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AnnotatorErrorBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyph" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorLabelBrush}" />
            </Style>
            <!-- Filled glyphs use opaque equivalents of the translucent label colors (label and disabled over the toolbar's
                 window background, secondary over the menu background): a translucent fill with its stroke on top adds up
                 to a darker edge, and an SF Symbol is one shape in one color. -->
            <Style x:Key="AnnotatorGlyphFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorLabelSolidBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorLabelSolidBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphSecondary" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorSecondaryLabelBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphSecondaryFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorSecondaryLabelSolidBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorSecondaryLabelSolidBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphDisabled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorDisabledLabelBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphDisabledFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorDisabledLabelSolidBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorDisabledLabelSolidBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphAccent" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorAccentBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphAccentFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorAccentBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorAccentBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphOnColor" TargetType="Path">
                <Setter Property="Stroke" Value="#FFFFFFFF" />
            </Style>
            <Style x:Key="AnnotatorGlyphOnColorFilled" TargetType="Path">
                <Setter Property="Stroke" Value="#FFFFFFFF" />
                <Setter Property="Fill" Value="#FFFFFFFF" />
            </Style>
            <Style x:Key="AnnotatorGlyphError" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorErrorBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphErrorFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorErrorBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorErrorBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphOnAccent" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorMenuAccentForegroundBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphOnAccentFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorMenuAccentForegroundBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorMenuAccentForegroundBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphWarning" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorWarningBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphWarningFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorWarningBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorWarningBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphOrange" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorOrangeBrush}" />
            </Style>
            <Style x:Key="AnnotatorGlyphOrangeFilled" TargetType="Path">
                <Setter Property="Stroke" Value="{ThemeResource AnnotatorOrangeBrush}" />
                <Setter Property="Fill" Value="{ThemeResource AnnotatorOrangeBrush}" />
            </Style>
            <Style x:Key="AnnotatorDivider" TargetType="Rectangle">
                <Setter Property="Fill" Value="{ThemeResource AnnotatorSeparatorBrush}" />
            </Style>
            <!-- The precise value field: the Mac's 48 by 21 point rounded field with caption-size digits. -->
            <Style x:Key="AnnotatorValueField" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Padding" Value="6,2,4,1" />
                <Setter Property="IsSpellCheckEnabled" Value="False" />
                <Setter Property="IsTextPredictionEnabled" Value="False" />
            </Style>
            <Style x:Key="AnnotatorSlider" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
            </Style>
            <!-- Toolbar and menu buttons draw no system chrome: a subtle fill on hover and press, like the Mac
                 toolbar. Tool selection is drawn by the toolbar's own marker, so Checked adds no fill. -->
            <Style x:Key="AnnotatorPlainButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorHoverFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorPressedFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The Mac's small pop-up button (NSPopUpButton in CoverPropertiesView): a static 8% fill with 5-point corners
                 that darkens while pressed. -->
            <Style x:Key="AnnotatorPopUpButton" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource AnnotatorPopUpFillBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorPopUpPressedBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The tray flyout's rows: MenuPopoverRow's hover fill (Color.primary at 6.5%) and the popover's own focus rings
                 (TrayFlyout), so no system focus visual. Buttons with their own surface set AnnotatorMenuHoverBrush to
                 transparent in their resources, as the Mac's primary and half buttons do not change on hover. -->
            <Style x:Key="AnnotatorMenuRowButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorMenuHoverBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorMenuHoverBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AnnotatorToolButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="FocusVisualMargin" Value="-2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <ContentPresenter x:Name="ContentPresenter"
                                              Background="{TemplateBinding Background}"
                                              CornerRadius="{TemplateBinding CornerRadius}"
                                              Padding="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Foreground="{TemplateBinding Foreground}"
                                              AutomationProperties.AccessibilityView="Raw">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorHoverFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorPressedFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled" />
                                        <VisualState x:Name="Checked" />
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorHoverFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorPressedFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled" />
                                        <VisualState x:Name="Indeterminate" />
                                        <VisualState x:Name="IndeterminatePointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorHoverFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminatePressed">
                                            <VisualState.Setters>
                                                <Setter Target="ContentPresenter.Background" Value="{ThemeResource AnnotatorPressedFillBrush}" />
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource AnnotatorHoverStrokeBrush}" />
                                                <Setter Target="ContentPresenter.BorderThickness" Value="{ThemeResource AnnotatorHoverStrokeThickness}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="IndeterminateDisabled" />
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </ContentPresenter>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The selection menu: the toolbar's plain look on a drop-down button whose content draws its own chevron. -->
